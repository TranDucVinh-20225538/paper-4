.DS_Store
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/

# Pretrained backbone: 1.35 GB, published by the PanDerm authors, not produced
# here. Pinned by SHA-256 in PROVENANCE.tsv instead of being vendored.
PhaseB/assets/checkpoints/*.pth
PhaseB/assets/checkpoints/*.pt

# Extracted embeddings: regenerated by the extraction scripts from the
# checkpoint above. Hashes are in PROVENANCE.tsv.
*.npy
*.npz

# Cached logs from individual runs
*.log

# Vendored upstream PanDerm source. It carries its own .git, so tracking it here
# would store a gitlink that clones cannot resolve. Pinned in
# PhaseB/external/PanDerm.pin instead; no local modifications to restore.
PhaseB/external/PanDerm/

# Hand-off bundles of the ignored artifacts above. Built on demand for someone
# who cannot regenerate them; distributed as a release asset, never committed.
embeddings_items*.zip
