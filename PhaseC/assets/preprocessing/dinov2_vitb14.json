{
  "backbone": "dinov2_vitb14",
  "description": "DINOv2 ViT-B/14 (LVD-142M), CLS token after final norm, 768-d",
  "frozen_from": {
    "repo": "https://github.com/facebookresearch/dinov2",
    "transforms": "Resize(256, bicubic), CenterCrop(224), Normalize ImageNet (dinov2/data/transforms.py make_classification_eval_transform)"
  },
  "dataset_level": "PIL image .convert('RGB') before the pipeline",
  "pipeline": [
    {
      "op": "Resize",
      "size": 256,
      "interpolation": "bicubic",
      "antialias": true
    },
    {
      "op": "CenterCrop",
      "size": [
        224,
        224
      ]
    },
    {
      "op": "ToTensor"
    },
    {
      "op": "Normalize",
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    }
  ]
}
